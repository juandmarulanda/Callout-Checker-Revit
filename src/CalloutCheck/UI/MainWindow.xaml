<Window x:Class="CalloutCheck.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CalloutCheck"
        Width="1040" Height="700" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="12.5"
        Background="White">
    <Window.Resources>
        <ResourceDictionary Source="pack://application:,,,/CalloutCheck;component/UI/Styles.xaml"/>
    </Window.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource AccentLightBrush}" Padding="14,10"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Image x:Name="HeaderIcon" Width="32" Height="32" Margin="0,0,10,0" DockPanel.Dock="Left"/>
                <Button DockPanel.Dock="Right" Content="&#x21BB;  Refresh" Command="{Binding RefreshCommand}"
                        Style="{StaticResource PrimaryButton}" VerticalAlignment="Center"
                        ToolTip="Re-read the model (do this after adding callouts)"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CalloutCheck" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Foreground="{StaticResource MutedBrush}">
                        <Run Text="Project: "/><Run Text="{Binding DocumentTitle, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="#F6F7F9" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="12,5">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding AuthorLine}" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>
            </DockPanel>
        </Border>

        <TabControl Margin="10,8,10,8" Padding="10">
            <!-- ============================== Tab 1: callout audit -->
            <TabItem Header="  Callout Audit  ">
                <DockPanel>
                    <Expander DockPanel.Dock="Top" IsExpanded="{Binding SheetsExpanded}" Margin="0,0,0,8">
                        <Expander.Header>
                            <TextBlock Text="{Binding SheetsHeader}" FontWeight="SemiBold"/>
                        </Expander.Header>
                        <DockPanel Margin="18,6,0,0">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <TextBlock Text="Sheet number/name contains:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Button DockPanel.Dock="Right" Content="None" Command="{Binding UncheckAllSheetsCommand}"/>
                                <Button DockPanel.Dock="Right" Content="All" Command="{Binding CheckAllSheetsCommand}"/>
                                <Button DockPanel.Dock="Right" Content="Select matching" Command="{Binding ApplySheetFilterCommand}"
                                        ToolTip="Check every sheet whose number or name contains one of the keywords, then refresh"/>
                                <TextBox Text="{Binding SheetFilter, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                                         ToolTip="Separate several keywords with ';'  e.g.  DETAIL; A5"/>
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"
                                       Text="Tip: after changing the checked sheets, click Refresh."/>
                            <ListBox ItemsSource="{Binding Sheets}" MaxHeight="170" BorderBrush="{StaticResource BorderBrush}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Vertical" MaxHeight="160"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Display}" Margin="0,1,14,1"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Expander>

                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding OnlyOnSheets}" VerticalAlignment="Center" Margin="12,0,0,0"
                                  Content="Only count callouts in views placed on sheets"
                                  ToolTip="When on, a callout drawn in a working view that is not on any sheet does not count."/>
                        <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Height="24"/>
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Missing -->
                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource ListHeader}" Foreground="{StaticResource MissingBrush}"
                                       Text="{Binding UntaggedHeader}"/>
                            <ListBox ItemsSource="{Binding Untagged}" Style="{StaticResource CardList}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3" ToolTip="{Binding ToolTip}">
                                            <Border DockPanel.Dock="Left" Style="{StaticResource Badge}" Background="{StaticResource MissingLightBrush}">
                                                <TextBlock Text="{Binding Reference}" Foreground="{StaticResource MissingBrush}"
                                                           HorizontalAlignment="Center" FontSize="11"/>
                                            </Border>
                                            <Button DockPanel.Dock="Right" Content="Copy" Style="{StaticResource SmallButton}"
                                                    ToolTip="Copy the view name to paste it as the callout reference"
                                                    Command="{Binding DataContext.CopyNameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                <Hyperlink Command="{Binding DataContext.OpenViewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding}">
                                                    <Run Text="{Binding ViewName, Mode=OneWay}"/>
                                                </Hyperlink>
                                            </TextBlock>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <!-- Called out -->
                        <DockPanel Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource ListHeader}" Foreground="{StaticResource OkBrush}"
                                       Text="{Binding TaggedHeader}"/>
                            <ListBox ItemsSource="{Binding Tagged}" Style="{StaticResource CardList}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3" ToolTip="{Binding ToolTip}">
                                            <Border DockPanel.Dock="Left" Style="{StaticResource Badge}" Background="{StaticResource OkLightBrush}">
                                                <TextBlock Text="{Binding Reference}" Foreground="{StaticResource OkBrush}"
                                                           HorizontalAlignment="Center" FontSize="11"/>
                                            </Border>
                                            <Button DockPanel.Dock="Right" Content="Where?" Style="{StaticResource SmallButton}"
                                                    ToolTip="Show the sheets where this detail is called out"
                                                    Command="{Binding DataContext.ShowLocationsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                            <Border DockPanel.Dock="Right" Background="{StaticResource AccentBrush}" CornerRadius="9"
                                                    MinWidth="24" Padding="6,1" Margin="6,0,2,0" VerticalAlignment="Center"
                                                    ToolTip="{Binding CountText}">
                                                <TextBlock Text="{Binding Count}" Foreground="White" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" FontSize="11"/>
                                            </Border>
                                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                <Hyperlink Command="{Binding DataContext.OpenViewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding}">
                                                    <Run Text="{Binding ViewName, Mode=OneWay}"/>
                                                </Hyperlink>
                                            </TextBlock>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ============================== Tab 2: renumber -->
            <TabItem Header="  Renumber Views  ">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"
                               Text="Open a sheet in Revit and click 'Pick order', then click its views one by one in the order you want (ESC to finish). The views get consecutive detail numbers in that order. You can also fine-tune the order with the arrows."/>

                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Pick order" Style="{StaticResource PrimaryButton}" Command="{Binding PickOrderCommand}"
                                ToolTip="Click the views on the active sheet in the new order"/>
                        <Button DockPanel.Dock="Right" Content="Load active sheet" Command="{Binding LoadActiveSheetCommand}"/>
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold">
                            <Run Text="Sheet: "/><Run Text="{Binding RenumberSheetText, Mode=OneWay}"/>
                        </TextBlock>
                    </DockPanel>

                    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Content="Apply numbering" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ApplyRenumberCommand}"/>
                        <TextBlock Text="Start at:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding StartNumber, UpdateSourceTrigger=PropertyChanged}" Width="44" VerticalContentAlignment="Center"/>
                        <CheckBox IsChecked="{Binding NumberUnpickedAfter}" VerticalAlignment="Center" Margin="14,0,0,0"
                                  Content="Number views I didn't pick after the picked ones"
                                  ToolTip="When off, views you didn't pick keep their current number"/>
                        <Button Content="Include all" Command="{Binding IncludeAllCommand}" Margin="14,0,0,0" HorizontalAlignment="Left"/>
                    </DockPanel>

                    <ListView ItemsSource="{Binding Viewports}" BorderBrush="{StaticResource BorderBrush}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Use" Width="40">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Included}" ToolTip="Renumber this view"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Pick" Width="46" DisplayMemberBinding="{Binding PickText}"/>
                                <GridViewColumn Header="Current #" Width="70" DisplayMemberBinding="{Binding CurrentNumber}"/>
                                <GridViewColumn Header="New #" Width="62">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding NewNumber}" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Changes}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="View name" Width="420" DisplayMemberBinding="{Binding ViewName}"/>
                                <GridViewColumn Header="Type" Width="90" DisplayMemberBinding="{Binding ViewKind}"/>
                                <GridViewColumn Header="Order" Width="80">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="&#x25B2;" Style="{StaticResource SmallButton}" Margin="0" ToolTip="Move up"
                                                        Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="&#x25BC;" Style="{StaticResource SmallButton}" Margin="2,0,0,0" ToolTip="Move down"
                                                        Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
