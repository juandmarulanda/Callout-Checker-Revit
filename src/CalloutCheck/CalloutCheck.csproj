<Project Sdk="Microsoft.NET.Sdk">

  <!--
    One project, three Revit versions. Pick the version with -p:RevitVersion=2025|2026|2027
    (defaults to 2026). Revit 2025/2026 run on .NET 8, Revit 2027 runs on .NET 10.
  -->
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2026</RevitVersion>
    <TargetFramework Condition="'$(RevitVersion)' == '2027'">net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' != '2027'">net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>CalloutCheck</RootNamespace>
    <AssemblyName>CalloutCheck</AssemblyName>
    <Version>2.0.0</Version>
    <Authors>Juan Marulanda</Authors>
    <Product>CalloutCheck</Product>
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
    <OutputPath>..\..\bin\$(Configuration)\$(RevitVersion)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <Company>Juan Marulanda</Company>
    <Copyright>© 2026 Juan Marulanda. All rights reserved.</Copyright>
    <Description>CalloutCheck for Revit</Description>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=CalloutCheck</PathMap>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\icon16.png" />
    <Resource Include="Resources\icon32.png" />
    <None Include="..\..\CalloutCheck.addin" Link="CalloutCheck.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Release builds are obfuscated (private/internal names renamed, strings hidden).
    Public API used by Revit and by XAML bindings is kept. Requires: dotnet tool restore.
    Skip with -p:Obfuscate=false.
  -->
  <Target Name="CcObfuscate" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' AND '$(Obfuscate)' != 'false'">
    <PropertyGroup>
      <_CcObfDir>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)obf/</_CcObfDir>
      <_CcObfIn>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)</_CcObfIn>
      <_CcObfConfig>$(_CcObfDir)obfuscar.xml</_CcObfConfig>
    </PropertyGroup>
    <ItemGroup>
      <_CcRefDir Include="@(ReferencePath->'%(RootDir)%(Directory)')" />
    </ItemGroup>
    <RemoveDuplicates Inputs="@(_CcRefDir)">
      <Output TaskParameter="Filtered" ItemName="_CcRefDirU" />
    </RemoveDuplicates>
    <ItemGroup>
      <_CcLine Include="&lt;?xml version='1.0'?&gt;" />
      <_CcLine Include="&lt;Obfuscator&gt;" />
      <_CcLine Include="&lt;Var name='InPath' value='$(_CcObfIn)' /&gt;" />
      <_CcLine Include="&lt;Var name='OutPath' value='$(_CcObfDir)out' /&gt;" />
      <_CcLine Include="&lt;Var name='KeepPublicApi' value='true' /&gt;" />
      <_CcLine Include="&lt;Var name='HidePrivateApi' value='true' /&gt;" />
      <_CcLine Include="&lt;Var name='HideStrings' value='true' /&gt;" />
      <_CcLine Include="&lt;Var name='RenameProperties' value='true' /&gt;" />
      <_CcLine Include="&lt;Var name='RenameEvents' value='true' /&gt;" />
      <_CcLine Include="&lt;Var name='RenameFields' value='true' /&gt;" />
      <_CcLine Include="&lt;Var name='ReuseNames' value='true' /&gt;" />
      <_CcLine Include="&lt;Var name='UseUnicodeNames' value='false' /&gt;" />
      <_CcLine Include="&lt;Var name='OptimizeMethods' value='true' /&gt;" />
      <_CcLine Include="&lt;Var name='SuppressIldasm' value='true' /&gt;" />
      <_CcLine Include="&lt;AssemblySearchPath path='%(_CcRefDirU.Identity)' /&gt;" />
      <_CcLine Include="&lt;Module file='$(_CcObfIn)$(TargetFileName)' /&gt;" />
      <_CcLine Include="&lt;/Obfuscator&gt;" />
    </ItemGroup>
    <MakeDir Directories="$(_CcObfDir)" />
    <WriteLinesToFile File="$(_CcObfConfig)" Lines="@(_CcLine)" Overwrite="true" />
    <Exec Command="dotnet tool run obfuscar.console &quot;$(_CcObfConfig)&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)" StandardOutputImportance="low" />
    <Copy SourceFiles="$(_CcObfDir)out/$(TargetFileName)" DestinationFolder="$(OutDir)" />
    <Message Importance="high" Text="CalloutCheck: obfuscated $(TargetFileName) for Revit $(RevitVersion)" />
  </Target>

</Project>
